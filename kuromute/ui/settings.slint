import { Button, CheckBox, ComboBox, ScrollView, Slider, Palette as StdPalette } from "std-widgets.slint";

export global Palette {
    out property <color> window-bg: #202020;
    out property <color> sidebar-bg: #1b1b1b;
    out property <color> card-bg: #2b2b2b;
    out property <color> item-active: #333333;
    out property <color> item-hover: #2a2a2a;
    out property <color> text: #ffffff;
    out property <color> text-dim: #9d9d9d;
    out property <color> accent: #60cdff;
}

// Filled from Rust (ui::apply_lang); Task 9 re-applies on language change.
export global Strings {
    in property <string> tab-mic;
    in property <string> tab-indicator;
    in property <string> tab-device;
    in property <string> tab-general;
    in property <string> placeholder;
    in property <string> sec-mic;
    in property <string> mic-label;
    in property <string> sec-hotkey;
    in property <string> hotkey-label;
    in property <string> record;
    in property <string> recording;
    in property <string> hotkey-key;
    in property <string> hotkey-mods;
    in property <string> hotkey-leaks;
    in property <string> sec-talk-warn;
    in property <string> talk-warn-enabled;
    in property <string> talk-warn-source;
    in property <string> talk-warn-note;
    in property <string> sec-test;
    in property <string> test-label;
    in property <string> test-button;
    in property <string> sec-popup;
    in property <string> popup-enabled;
    in property <string> popup-position;
    in property <string> popup-scale;
    in property <string> popup-persist;
    in property <string> sec-border;
    in property <string> border-enabled;
    in property <string> border-thickness;
    in property <string> border-style;
    in property <[string]> border-styles;
    in property <string> sec-monitors;
    in property <string> all-monitors;
    in property <string> sec-sound;
    in property <string> sound-enabled;
    in property <[string]> positions;
    in property <string> sec-defaults;
    in property <string> default-input;
    in property <string> default-output;
    in property <string> force-on-startup;
    in property <string> sec-guard;
    in property <string> guard-enabled;
    in property <string> guard-mode-label;
    in property <[string]> guard-modes;
    in property <string> sec-general;
    in property <string> lang-label;
    in property <[string]> lang-options;
    in property <string> autostart-label;
    in property <string> version-label;
    in property <string> sec-updates;
    in property <string> check-update;
    in property <string> open-release;
    in property <string> logs-label;
    in property <string> logs-btn;
    in property <string> bug-label;
    in property <string> bug-btn;
    in property <string> sec-support;
    in property <string> support-saweria;
    in property <string> support-saweria-btn;
    in property <string> support-topup;
    in property <string> support-topup-btn;
    in property <string> made-with-slint;
}

export struct MonitorItem { label: string, checked: bool }

component SectionTitle inherits Text {
    color: Palette.text-dim;
    font-size: 12px;
    font-weight: 600;
    min-height: 28px;
    vertical-alignment: bottom;
}

// Layout B card row: label left, controls right.
component Row inherits Rectangle {
    in property <string> label;
    min-height: 52px;
    border-radius: 6px;
    background: Palette.card-bg;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        Text {
            text: root.label;
            color: Palette.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
}

component Note inherits Text {
    wrap: word-wrap;
    font-size: 12px;
}

component SideItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 40px;
    border-radius: 6px;
    background: active ? Palette.item-active : ta.has-hover ? Palette.item-hover : transparent;
    Rectangle {
        x: 0px;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Palette.accent;
        visible: root.active;
    }
    Text {
        x: 16px;
        text: root.label;
        color: Palette.text;
        font-size: 14px;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    in-out property <int> tab: 0;
    // Mic tab (filled by settings::mic)
    in property <[string]> mic-names;
    in-out property <int> mic-index: -1;
    callback mic-selected(int);
    in-out property <bool> talk-enabled;
    in property <[string]> talk-mic-names;
    in-out property <int> talk-mic-index: -1;
    callback talk-changed();
    callback talk-mic-selected(int);
    in property <string> hotkey-text;
    in property <bool> recording;
    callback record-clicked();
    in property <[string]> key-names;
    in-out property <int> key-index: -1;
    in-out property <bool> mod-ctrl;
    in-out property <bool> mod-alt;
    in-out property <bool> mod-shift;
    in-out property <bool> mod-win;
    callback hotkey-picked();
    in property <string> hotkey-error;
    in property <bool> hotkey-warn;
    in property <string> save-error;
    in property <string> core-info;
    callback test-mute();
    // Penanda tab (filled by settings::penanda)
    in-out property <bool> pen-popup-enabled;
    in-out property <int> pen-position-index: -1;
    in-out property <float> pen-scale: 1.0;
    in-out property <bool> pen-persist;
    in-out property <bool> pen-border-enabled;
    in-out property <float> pen-thickness: 6;
    in-out property <int> pen-border-style-index: -1;
    in-out property <bool> pen-all-monitors: true;
    in property <[MonitorItem]> pen-monitors;
    in-out property <bool> pen-sound;
    callback pen-changed();
    callback pen-scale-changed(float);
    callback pen-thickness-changed(float);
    callback monitor-toggled(int, bool);
    callback tab-opened(int);
    // Device tab (filled by settings::device)
    in property <[string]> dev-output-names;
    in-out property <int> dev-output-index: 0;
    in property <[string]> dev-input-names;
    in-out property <int> dev-input-index: 0;
    in-out property <bool> dev-force;
    in-out property <bool> dev-guard;
    in-out property <int> dev-guard-mode: -1;
    callback dev-changed();
    // Umum tab (filled by settings::umum)
    in-out property <int> gen-lang: 0;
    in-out property <bool> gen-autostart;
    in property <string> app-version;
    in property <string> upd-text;
    in property <string> upd-url;
    in property <bool> upd-link;
    in property <bool> upd-busy;
    callback gen-changed();
    callback check-update-clicked();
    callback open-release-clicked();
    callback open-logs-clicked();
    callback report-bug-clicked();
    callback support-saweria-clicked();
    callback support-topup-clicked();
    changed tab => { root.tab-opened(root.tab); }
    init => { StdPalette.color-scheme = ColorScheme.dark; }
    title: "Kuro Mute Settings"; // must equal settings::single::WINDOW_TITLE (asserted in ui.rs tests)
    icon: @image-url("../../kuro-mute-mic-logo.png");
    preferred-width: 760px;
    preferred-height: 520px;
    min-width: 760px;
    max-width: 760px;
    min-height: 520px;
    max-height: 520px;
    background: Palette.window-bg;
    default-font-size: 14px;

    HorizontalLayout {
        Rectangle {
            width: 180px;
            background: Palette.sidebar-bg;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;
                SideItem { label: Strings.tab-mic; active: root.tab == 0; clicked => { root.tab = 0; } }
                SideItem { label: Strings.tab-indicator; active: root.tab == 1; clicked => { root.tab = 1; } }
                SideItem { label: Strings.tab-device; active: root.tab == 2; clicked => { root.tab = 2; } }
                SideItem { label: Strings.tab-general; active: root.tab == 3; clicked => { root.tab = 3; } }
            }
        }
        VerticalLayout {
          Rectangle {
            vertical-stretch: 1;
            if root.tab == 0: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: start;
                    if root.save-error != "": Note { text: root.save-error; color: #ff6b6b; }
                    SectionTitle { text: Strings.sec-mic; }
                    Row {
                        label: Strings.mic-label;
                        ComboBox {
                            width: 300px;
                            model: root.mic-names;
                            current-index <=> root.mic-index;
                            selected => { root.mic-selected(self.current-index); }
                        }
                    }
                    SectionTitle { text: Strings.sec-hotkey; }
                    Row {
                        label: Strings.hotkey-label;
                        Text {
                            text: root.recording ? Strings.recording : root.hotkey-text;
                            color: root.recording ? Palette.accent : Palette.text;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Button {
                            text: Strings.record;
                            enabled: !root.recording;
                            clicked => { root.record-clicked(); }
                        }
                    }
                    Row {
                        label: Strings.hotkey-key;
                        ComboBox {
                            width: 180px;
                            enabled: !root.recording;
                            model: root.key-names;
                            current-index <=> root.key-index;
                            selected => { root.hotkey-picked(); }
                        }
                    }
                    Row {
                        label: Strings.hotkey-mods;
                        CheckBox { text: "Ctrl"; enabled: !root.recording; checked <=> root.mod-ctrl; toggled => { root.hotkey-picked(); } }
                        CheckBox { text: "Alt"; enabled: !root.recording; checked <=> root.mod-alt; toggled => { root.hotkey-picked(); } }
                        CheckBox { text: "Shift"; enabled: !root.recording; checked <=> root.mod-shift; toggled => { root.hotkey-picked(); } }
                        CheckBox { text: "Win"; enabled: !root.recording; checked <=> root.mod-win; toggled => { root.hotkey-picked(); } }
                    }
                    if root.hotkey-error != "": Note { text: root.hotkey-error; color: #ff6b6b; }
                    if root.hotkey-warn: Note { text: Strings.hotkey-leaks; color: #f7c948; }
                    SectionTitle { text: Strings.sec-talk-warn; }
                    Row {
                        label: Strings.talk-warn-enabled;
                        CheckBox { checked <=> root.talk-enabled; toggled => { root.talk-changed(); } }
                    }
                    if root.talk-enabled: Row {
                        label: Strings.talk-warn-source;
                        ComboBox {
                            width: 300px;
                            model: root.talk-mic-names;
                            current-index <=> root.talk-mic-index;
                            selected => { root.talk-mic-selected(self.current-index); }
                        }
                    }
                    if root.talk-enabled: Note { text: Strings.talk-warn-note; color: Palette.text-dim; }
                    SectionTitle { text: Strings.sec-test; }
                    Row {
                        label: Strings.test-label;
                        Button { text: Strings.test-button; clicked => { root.test-mute(); } }
                    }
                }
            }
            if root.tab == 1: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: start;
                    if root.save-error != "": Note { text: root.save-error; color: #ff6b6b; }
                    SectionTitle { text: Strings.sec-popup; }
                    Row {
                        label: Strings.popup-enabled;
                        CheckBox { checked <=> root.pen-popup-enabled; toggled => { root.pen-changed(); } }
                    }
                    if root.pen-popup-enabled: Row {
                        label: Strings.popup-position;
                        ComboBox {
                            width: 180px;
                            model: Strings.positions;
                            current-index <=> root.pen-position-index;
                            selected => { root.pen-changed(); }
                        }
                    }
                    if root.pen-popup-enabled: Row {
                        label: Strings.popup-scale + " " + Math.round(root.pen-scale * 10) / 10 + "x";
                        Slider {
                            width: 200px;
                            minimum: 0.5;
                            maximum: 2.0;
                            value <=> root.pen-scale;
                            changed(v) => { root.pen-scale-changed(v); }
                        }
                    }
                    if root.pen-popup-enabled: Row {
                        label: Strings.popup-persist;
                        CheckBox { checked <=> root.pen-persist; toggled => { root.pen-changed(); } }
                    }
                    SectionTitle { text: Strings.sec-border; }
                    Row {
                        label: Strings.border-enabled;
                        CheckBox { checked <=> root.pen-border-enabled; toggled => { root.pen-changed(); } }
                    }
                    if root.pen-border-enabled: Row {
                        label: Strings.border-thickness + " " + Math.round(root.pen-thickness) + " px";
                        Slider {
                            width: 200px;
                            minimum: 1;
                            maximum: 30;
                            value <=> root.pen-thickness;
                            changed(v) => { root.pen-thickness-changed(v); }
                        }
                    }
                    if root.pen-border-enabled: Row {
                        label: Strings.border-style;
                        ComboBox {
                            width: 180px;
                            model: Strings.border-styles;
                            current-index <=> root.pen-border-style-index;
                            selected => { root.pen-changed(); }
                        }
                    }
                    SectionTitle { text: Strings.sec-monitors; }
                    Row {
                        label: Strings.all-monitors;
                        CheckBox { checked <=> root.pen-all-monitors; toggled => { root.pen-changed(); } }
                    }
                    if !root.pen-all-monitors: VerticalLayout {
                        spacing: 8px;
                        for m[i] in root.pen-monitors: Row {
                            label: m.label;
                            CheckBox { checked: m.checked; toggled => { root.monitor-toggled(i, self.checked); } }
                        }
                    }
                    SectionTitle { text: Strings.sec-sound; }
                    Row {
                        label: Strings.sound-enabled;
                        CheckBox { checked <=> root.pen-sound; toggled => { root.pen-changed(); } }
                    }
                }
            }
            if root.tab == 2: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: start;
                    if root.save-error != "": Note { text: root.save-error; color: #ff6b6b; }
                    SectionTitle { text: Strings.sec-defaults; }
                    Row {
                        label: Strings.default-output;
                        ComboBox {
                            width: 300px;
                            model: root.dev-output-names;
                            current-index <=> root.dev-output-index;
                            selected => { root.dev-changed(); }
                        }
                    }
                    Row {
                        label: Strings.default-input;
                        ComboBox {
                            width: 300px;
                            model: root.dev-input-names;
                            current-index <=> root.dev-input-index;
                            selected => { root.dev-changed(); }
                        }
                    }
                    Row {
                        label: Strings.force-on-startup;
                        CheckBox { checked <=> root.dev-force; toggled => { root.dev-changed(); } }
                    }
                    SectionTitle { text: Strings.sec-guard; }
                    Row {
                        label: Strings.guard-enabled;
                        CheckBox { checked <=> root.dev-guard; toggled => { root.dev-changed(); } }
                    }
                    if root.dev-guard: Row {
                        label: Strings.guard-mode-label;
                        ComboBox {
                            width: 220px;
                            model: Strings.guard-modes;
                            current-index <=> root.dev-guard-mode;
                            selected => { root.dev-changed(); }
                        }
                    }
                }
            }
            if root.tab == 3: ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: start;
                    if root.save-error != "": Note { text: root.save-error; color: #ff6b6b; }
                    SectionTitle { text: Strings.sec-general; }
                    Row {
                        label: Strings.lang-label;
                        ComboBox {
                            width: 220px;
                            model: Strings.lang-options;
                            current-index <=> root.gen-lang;
                            selected => { root.gen-changed(); }
                        }
                    }
                    Row {
                        label: Strings.autostart-label;
                        CheckBox { checked <=> root.gen-autostart; toggled => { root.gen-changed(); } }
                    }
                    Row {
                        label: Strings.version-label;
                        Text { text: root.app-version; color: Palette.text-dim; vertical-alignment: center; }
                    }
                    SectionTitle { text: Strings.sec-support; }
                    Row {
                        label: Strings.support-saweria;
                        Button { text: Strings.support-saweria-btn; clicked => { root.support-saweria-clicked(); } }
                    }
                    Row {
                        label: Strings.support-topup;
                        Button { text: Strings.support-topup-btn; clicked => { root.support-topup-clicked(); } }
                    }
                    SectionTitle { text: Strings.sec-updates; }
                    Row {
                        label: root.upd-text;
                        if root.upd-link: Button { text: Strings.open-release; clicked => { root.open-release-clicked(); } }
                        Button { text: Strings.check-update; enabled: !root.upd-busy; clicked => { root.check-update-clicked(); } }
                    }
                    Row {
                        label: Strings.logs-label;
                        Button { text: Strings.logs-btn; clicked => { root.open-logs-clicked(); } }
                    }
                    Row {
                        label: Strings.bug-label;
                        Button { text: Strings.bug-btn; clicked => { root.report-bug-clicked(); } }
                    }
                    Note { text: Strings.made-with-slint; color: Palette.text-dim; horizontal-alignment: center; }
                }
            }
          }
          if root.core-info != "": VerticalLayout {
              padding-left: 24px;
              padding-right: 24px;
              padding-bottom: 8px;
              Note { text: root.core-info; color: #f7c948; }
          }
        }
    }
}
